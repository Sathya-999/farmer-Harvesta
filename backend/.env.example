# ==============================================================================
# Agricultural Intelligence Platform — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (.env is listed in .gitignore).
#
# LOADING .env IN DEVELOPMENT:
#   Spring Boot does NOT read .env automatically.
#   Use one of:
#   A) IntelliJ IDEA → Run/Debug Configuration → "Env file: .env"
#      (requires EnvFile plugin or IDEA 2023.1+ native support)
#   B) VS Code: Reference .env in launch.json envFile property
#   C) PowerShell before `mvn spring-boot:run`:
#        Get-Content .env | ForEach-Object {
#          if ($_ -match '^([^#][^=]*)=(.*)$') {
#            [System.Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim())
#          }
#        }
#   D) Shell (bash/zsh): `export $(grep -v '^#' .env | xargs)`
# ==============================================================================

# -----------------------------------------------
# Spring Boot — Active Profile
# -----------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------
# Supabase PostgreSQL Database Credentials
#
# CORRECT CONNECTION MODE FOR SPRING BOOT + JPA:
#
#   Use the SESSION POOLER (port 5432).
#
#   Reason (per official Supabase documentation):
#   https://supabase.com/docs/guides/database/connecting-to-postgres
#
#   - Transaction Pooler (port 6543) operates in transaction mode and does
#     NOT support server-side prepared statements between transactions.
#   - Hibernate/JPA (and most ORMs) rely on server-side prepared statements
#     for performance and correctness.
#   - Using Transaction Pooler (6543) with JPA/Hibernate can cause runtime
#     errors such as "prepared statement already exists" or
#     "prepared statement does not exist".
#   - Session Pooler (port 5432) preserves session state and is fully
#     compatible with JPA/Hibernate prepared statement usage.
#
# HOW TO FIND YOUR SESSION POOLER URL:
#   Supabase Dashboard → Your Project → Connect
#   → "Session Pooler" tab → copy the JDBC URI
#   It will look like:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
#
# SSL NOTE:
#   Supabase requires SSL. Append ?sslmode=require to the JDBC URL.
#   Do NOT use sslmode=disable.
#
# USERNAME FORMAT:
#   Session Pooler username format: postgres.[your-project-ref]
#   (same format as Transaction Pooler)
#
# IMPORTANT — DO NOT confuse these with:
#   - Supabase anon key    (used by Flutter client, NOT for JDBC)
#   - Supabase service key (REST/Admin API only, NOT for JDBC)
#   - JWT secret           (used by Spring Security, NOT for JDBC)
#
# DO NOT use port 6543 (Transaction Pooler) as the primary JPA datasource.
# -----------------------------------------------
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.yourprojectref
SUPABASE_DB_PASSWORD=your_database_password_here

# -----------------------------------------------
# Supabase Auth — JWT (Spring Security Resource Server)
#
# Find these in: Supabase Dashboard → Project → Settings → API
#   JWT Issuer:   https://<project-ref>.supabase.co/auth/v1
#   JWKS URI:     https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# -----------------------------------------------
SUPABASE_JWT_ISSUER=https://yourprojectref.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URI=https://yourprojectref.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------
# CORS — Allowed origins for the Flutter web client
# Comma-separated list.
# -----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------
# LGD/NAPIX API Credentials
#
# Required for official LGD geography synchronization.
# Register at: https://napix.gov.in to obtain credentials.
#
# SECURITY:
#   - NEVER commit real credentials to version control.
#   - These are server-side only — never returned via any API.
#   - The Spring Boot application reads these via LgdProperties.
#   - Set scheduler-enabled=true in application.yml to activate weekly sync.
#
# Authentication mechanism (per official LGD OpenAPI specs):
#   Header: X-IBM-Client-Id
#   Header: X-IBM-Client-Secret
# -----------------------------------------------
LGD_CLIENT_ID=your_napix_lgd_client_id_here
LGD_CLIENT_SECRET=your_napix_lgd_client_secret_here
