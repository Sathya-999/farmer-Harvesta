<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         PARENT — Spring Boot BOM
    ====================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- =====================================================================
         PROJECT IDENTITY
    ====================================================================== -->
    <groupId>com.agriplatform</groupId>
    <artifactId>agri-platform-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>agri-platform-backend</name>
    <description>Agricultural Intelligence Platform — Farmer-first Modular Monolith Backend</description>

    <!-- =====================================================================
         PROPERTIES
    ====================================================================== -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- =====================================================================
         DEPENDENCIES
         Versions are managed by the Spring Boot parent BOM.
         Do NOT add explicit versions for BOM-managed dependencies.
    ====================================================================== -->
    <dependencies>

        <!-- ==============================================================
             A. WEB — REST API foundation
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ==============================================================
             B. SECURITY — HTTP security framework
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ==============================================================
             C. JWT / OAUTH2 RESOURCE SERVER
             Validates Supabase-issued JWT access tokens (future task).
             Architecture: Spring Security OAuth2 Resource Server.
             NOTE: JJWT is NOT added; this starter handles JWT natively.
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ==============================================================
             D. DATABASE ORM — JPA / Hibernate
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ==============================================================
             E. VALIDATION — Jakarta Bean Validation / @Valid / @NotNull
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==============================================================
             F. OBSERVABILITY — Health endpoint / Actuator
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==============================================================
             G. POSTGRESQL DRIVER
             Runtime scope — not needed at compile time.
             Required for Supabase PostgreSQL connection (future task).
        ============================================================== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==============================================================
             H. LOMBOK — Boilerplate reduction
        ============================================================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==============================================================
             I. DEVTOOLS — Development restart / reload
             Runtime only; excluded from production JAR automatically
             by the Spring Boot Maven plugin.
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ==============================================================
             TESTING
        ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test utilities -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================================
         BUILD
    ====================================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from the packaged JAR (compile-time only) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Surefire JVM args for Java 25 compatibility.
                Byte Buddy 1.14.x (bundled with mockito-core 5.11.0 via spring-boot-test 3.3.4)
                officially supports Java 23 (class file version 67) but not Java 25 (69).
                Setting net.bytebuddy.experimental=true enables experimental support for newer JVM versions.
                This is the recommended workaround per Mockito documentation and Byte Buddy project.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx512m -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

