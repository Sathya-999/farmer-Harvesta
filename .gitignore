# Root-level gitignore for farmer-Harvesta monorepo

# Node / Next.js
node_modules/
.next/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/
out/
build/

# Environment / Secrets
.env
.env.local
.env.*.local
*.env

# Maven / Java
target/
*.class
*.jar
*.war
*.ear
*.iml
*.ipr
*.iws
.idea/
.vscode/
.settings/
.classpath
.project
.factorypath
.springBeans
.sts4-cache
.apt_generated

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pem
.vercel

# Local dev scripts (machine-specific)
hs_err_pid*.log
replay_pid*.log
startup_err.txt
startup_out.txt
